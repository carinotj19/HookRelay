# Copy to .env; generate unique random secrets. Never commit real values.
POSTGRES_PASSWORD=change-this-strong-db-password
DATABASE_URL=postgresql+psycopg://hookrelay:change-this-strong-db-password@db:5432/hookrelay
REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=change-this-to-a-long-random-admin-key
# Only for deliberately isolated local demos (allows http://sink:PORT).
ALLOW_PRIVATE_DESTINATIONS=0
